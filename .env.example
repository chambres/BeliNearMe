# Your Beli user UUID
BELI_USER_ID=replace-with-your-beli-user-uuid

# Your Beli refresh token (mint a fresh one with: python -m scripts.login)
BELI_REFRESH_TOKEN=replace-with-your-beli-refresh-token

# Optional: only needed if you want `python -m scripts.login` to re-mint the
# refresh token without prompting. Leave blank to be prompted instead.
BELI_EMAIL=
BELI_PASSWORD=

# Optional overrides
BELI_API_BASE=https://backoffice-service-split-t57o3dxfca-nn.a.run.app/api
BELI_REQUEST_TIMEOUT_SECONDS=30
